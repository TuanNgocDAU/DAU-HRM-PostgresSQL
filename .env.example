# ---------------------------------------------------------------------------
# Sao chép file này thành .env.local rồi điền giá trị thật.
# .env.local đã được .gitignore bỏ qua (*.local) nên mật khẩu không bị commit.
# ---------------------------------------------------------------------------

# --- PostgreSQL local (C:\Program Files\PostgreSQL\18) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=qlns
PGUSER=postgres
PGPASSWORD=
PGSCHEMA=public
PGPOOL_MAX=10

# --- API server đọc/ghi PostgreSQL (Vite proxy /api trỏ tới cổng này) ---
API_PORT=3001
API_HOST=127.0.0.1

# --- Google Gemini (chức năng OCR / dịch trong Công cụ) ---
GEMINI_API_KEY=
